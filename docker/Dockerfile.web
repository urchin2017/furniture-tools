# apps/web 镜像：Next.js 构建 + 运行（npm workspaces，root 是 package.json 所在处）。
# 构建时 context 必须是仓库根：
#   docker build -f docker/Dockerfile.web -t furniture-web \
#     --build-arg NEXT_PUBLIC_SUPABASE_URL=... \
#     --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=... \
#     --build-arg NEXT_PUBLIC_API_BASE_URL=... ..
#
# NEXT_PUBLIC_* 会被 Next.js 在 `next build` 时内联进浏览器端 bundle，
# 所以必须当 build arg 传，光靠容器运行时的环境变量对客户端代码不生效。

FROM node:20-slim AS build
WORKDIR /repo

# 先只拷贝各 workspace 的 package.json + 根 lockfile，让 npm ci 的依赖层可以被 Docker 缓存。
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY shared/ts/package.json shared/ts/package.json
RUN npm ci

COPY apps/web apps/web
COPY shared/ts shared/ts

ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL

RUN npm run build --workspace=apps/web

FROM node:20-slim
WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY shared/ts/package.json shared/ts/package.json
RUN npm ci --omit=dev

COPY --from=build /repo/apps/web/.next apps/web/.next
COPY apps/web/next.config.mjs apps/web/next.config.mjs

WORKDIR /repo/apps/web
ENV PORT=3000
EXPOSE 3000
CMD ["npm", "run", "start"]
